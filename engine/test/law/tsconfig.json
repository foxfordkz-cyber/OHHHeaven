{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false,
    "types": []
  },
  "include": ["../../src/law/**/*.ts", "../fixtures/law-*.ts", "./**/*.ts", "../../../shared/src/*.ts"],
  "exclude": ["node_modules", "vitest.config.ts"]
}
