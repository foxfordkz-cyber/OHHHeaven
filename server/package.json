{
  "name": "@ohh/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "check": "tsc --noEmit -p tsconfig.json",
    "play": "tsx scripts/play.ts",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@ohh/ai": "*",
    "@ohh/bots": "*",
    "@ohh/engine": "*",
    "@ohh/host": "*",
    "@ohh/shared": "*",
    "express": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
