{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "include": [
    "../**/*.ts",
    "../**/*.tsx",
    "../../end/**/*.ts",
    "../../end/**/*.tsx",
    "./*.ts",
    "./*.tsx"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "../../end/node_modules",
    "dist",
    "./vite.config.ts"
  ]
}