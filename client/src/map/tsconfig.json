{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../screens/city/**/*.ts", "../screens/city/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
